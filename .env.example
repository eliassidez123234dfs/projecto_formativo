# =============================================================================
#  Red Estampación — Variables de Entorno (plantilla) de ejemplo
#  Copia este archivo a .env y completa con tus credenciales antes de ejecutar el proyecto.
# =============================================================================

# ── MODO DE OPERACIÓN ───────────────────────────────────────────────────────
# ENVIRONMENT: development | staging | production
ENVIRONMENT=development

# ── Backend Django ───────────────────────────────────────────────────────────
# Generar una clave secreta:  python -c "import secrets; print(secrets.token_url64(64))"
SECRET_KEY=django-insecure-projecto-formativo-dev-key
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Correo electrónico ───────────────────────────────────────────────────────
# EMAIL_BACKEND: console | smtp
#   - 'console': imprime los correos en la terminal (ideal para desarrollo/pruebas)
#   - 'smtp': envía correos reales (configurar credenciales SMTP)
EMAIL_BACKEND=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
DEFAULT_FROM_EMAIL=noreply@sistema.com

# ── Base de datos SQL ───────────────────────────────────────────────────────
# DB_TYPE: sqlite | postgres_local | postgres_docker | neon
#   - 'sqlite': base de datos local SQLite (desarrollo rápido)
#   - 'postgres_local': PostgreSQL instalado localmente
#   - 'postgres_docker': PostgreSQL en contenedor Docker
#   - 'neon': PostgreSQL en la nube (Neon)
DB_TYPE=sqlite

# Configuración PostgreSQL local/Docker
DATABASE_URL=postgres://proyecto_user:proyecto_pass@localhost:5432/projecto_formativo

# Configuración Neon (producción)
# DATABASE_URL=postgresql://user:pass@ep-region.aws.neon.tech/neondb?sslmode=require

# ── Base de datos NoSQL (MongoDB) ────────────────────────────────────────────
# USE_MONGODB: true | false
#   - 'true': habilita MongoDB para diseños 3D, logs, carritos
#   - 'false': usa solo Django ORM (PostgreSQL/SQLite)
USE_MONGODB=false
MONGODB_URI=mongodb://localhost:27017/projecto_formativo
MONGODB_NAME=projecto_formativo

# Configuración MongoDB Atlas (producción)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority&appName=ClusterRED0

# ── Sistema de Sesiones ──────────────────────────────────────────────────────
# SESSION_BACKEND: django_db | redis | cached_db
#   - 'django_db': sesiones almacenadas en base de datos Django
#   - 'redis': sesiones en Redis (requiere REDIS_URL)
#   - 'cached_db': caché Redis + persistencia en DB
SESSION_BACKEND=django_db
REDIS_URL=redis://localhost:6379/0

# ── Cloudinary (imágenes y modelos 3D) ──────────────────────────────────────
# USE_CLOUDINARY: true | false
#   - 'true': usa Cloudinary para almacenamiento multimedia
#   - 'false': usa almacenamiento local
USE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# ── Wompi (pagos) ───────────────────────────────────────────────────────────
# Obtén credenciales en: https://wompi.co
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_WEBHOOK_SECRET=
WOMPI_REDIRECT_URL=http://localhost:5173/checkout/confirmacion
WOMPI_API_URL=https://sandbox.wompi.co/v1

# ── Frontend / Vite ─────────────────────────────────────────────────────────
# Este archivo (raíz) es la ÚNICA fuente de variables para backend + frontend + Docker.
# El microservicio Editor 3D (Tshirt3D) usa su propio archivo: microservices/Tshirt3D/.env
VITE_API_URL=http://localhost:8000/api/
VITE_MEDIA_URL=http://localhost:8000/media/
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/<cloud_name>/image/upload

# ── Logging y Monitoria ───────────────────────────────────────────────────────
# LOG_OUTPUT: console | file | both
#   - 'console': muestra logs solo en la terminal (desarrollo)
#   - 'file': guarda logs en archivos (producción)
#   - 'both': muestra en terminal y guarda en archivos
LOG_OUTPUT=console

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
#   - 'DEBUG': información detallada de depuración
#   - 'INFO': información general del sistema
#   - 'WARNING': advertencias
#   - 'ERROR': errores
#   - 'CRITICAL': errores críticos
LOG_LEVEL=INFO

# LOG_DIR: directorio donde se guardan los archivos de log (solo si LOG_OUTPUT=file|both)
LOG_DIR=logs
