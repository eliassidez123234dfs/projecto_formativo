# =============================================================================
#  Red Estampación — Variables de Entorno (plantilla) de ejemplo
#  Copia este archivo a .env y completa con tus credenciales antes de ejecutar el proyecto.
# =============================================================================

# ── Backend Django ───────────────────────────────────────────────────────────
# Generar una clave secreta:  python -c "import secrets; print(secrets.token_url64(64))"
SECRET_KEY=django-insecure-projecto-formativo-dev-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# ── Redis (caché + Celery broker) ───────────────────────────────────────────
SESSION_BACKEND=cached_db
REDIS_URL=redis://localhost:6379/0

# ── Correo electrónico ───────────────────────────────────────────────────────
EMAIL_BACKEND=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
DEFAULT_FROM_EMAIL=noreply@sistema.com

# ── Base de datos SQL (PostgreSQL) — Neon ──────────────────────────────────
DATABASE_URL=

# ── Base de datos NoSQL (MongoDB) — Atlas ─────────────────────────────────
USE_MONGODB=true
MONGODB_URI=
MONGODB_NAME=projecto_formativo

# ── Cloudinary (imágenes y modelos 3D) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# ── Wompi (pagos) ───────────────────────────────────────────────────────────
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_WEBHOOK_SECRET=
WOMPI_REDIRECT_URL=http://localhost:5173/checkout/confirmacion
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CURRENCY=COP

# ── Frontend / Vite ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/
VITE_MEDIA_URL=http://localhost:8000/media/
VITE_EDITOR_3D_URL=http://localhost:5174
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/<cloud_name>/image/upload
VITE_WOMPI_PUBLIC_KEY=
