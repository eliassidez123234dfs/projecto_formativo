# =============================================================================
#  Red Estampación — Variables de Entorno (Plantilla de Configuración)
#  Copia este archivo a .env (desarrollo local) y completa con tus credenciales.
# =============================================================================

# ── Backend Django ───────────────────────────────────────────────────────────
# Generar una clave secreta segura en producción:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=django-insecure-projecto-formativo-dev-key
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,expensive-ferry-purchase.ngrok-free.dev
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,https://expensive-ferry-purchase.ngrok-free.dev
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,https://expensive-ferry-purchase.ngrok-free.dev
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# ── Base de datos SQL (PostgreSQL en producción / SQLite en desarrollo) ─────
DATABASE_URL=

# ── Base de datos NoSQL (MongoDB - Auditoría, telemetría y diseños) ─────────
# Local:   mongodb://localhost:27017/projecto_formativo
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/projecto_formativo?retryWrites=true&w=majority
USE_MONGODB=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=projecto_formativo

# ── Correo electrónico (Resend + Fallback SMTP / Console) ───────────────────
# EMAIL_BACKEND: 'console' (desarrollo local) o 'smtp' (producción/envío real)
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# ── Cloudinary (Imágenes y Modelos 3D) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Wompi (Pasarela de pagos) ────────────────────────────────────────────────
WOMPI_PUBLIC_KEY=pub_test_
WOMPI_PRIVATE_KEY=prv_test_
WOMPI_INTEGRITY_KEY=test_integrity_
WOMPI_WEBHOOK_SECRET=
WOMPI_REDIRECT_URL=http://localhost:5173/checkout/resultado
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CURRENCY=COP

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/
VITE_MEDIA_URL=http://localhost:8000/media/
VITE_EDITOR_3D_URL=http://localhost:5174
VITE_TSHIRT3D_URL=http://localhost:5174/
VITE_FRONTEND_URL=http://localhost:5173
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/<cloud_name>/image/upload
VITE_MODELS3D_API_URL=http://127.0.0.1:8000/api/models3d/models/
VITE_WOMPI_PUBLIC_KEY=pub_test_
