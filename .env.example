# Variables de entorno de ejemplo
# Copie este archivo a .env antes de ejecutar el proyecto.

# Backend Django
SECRET_KEY=django-insecure-projecto-formativo-dev-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@sistema.com

# Base de datos opcional para PostgreSQL
# DB_NAME=projecto_formativo
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=db
# DB_PORT=5432

# Frontend/Vite
VITE_API_URL=http://localhost:8000/api/
VITE_MEDIA_URL=http://localhost:8000/media/
