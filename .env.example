# =============================================================================
#  Red Estampación — Variables de Entorno (plantilla) de ejemplo
#  Copia este archivo a .env y completa con tus credenciales antes de ejecutar el proyecto.
# =============================================================================

# ── Backend Django ───────────────────────────────────────────────────────────
# Generar una clave secreta:  python -c "import secrets; print(secrets.token_url64(64))"
SECRET_KEY=django-insecure-projecto-formativo-dev-key
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Correo electrónico (desarrollo: imprime en consola) ─────────────────────
# En producción usa un backend real (SMTP, SendGrid, etc.)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ejemplo.com

# ── Base de datos SQL (PostgreSQL) — Neon ──────────────────────────────────
# Local sin Docker:  postgres://proyecto_user:proyecto_pass@localhost:5432/projecto_formativo
# Docker:            postgres://proyecto_user:proyecto_pass@postgres:5432/projecto_formativo
# Neon (producción): postgresql://user:pass@ep-region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Base de datos SQL (PostgreSQL) — Neon ──────────────────────────────────
# Local sin Docker:  postgres://proyecto_user:proyecto_pass@localhost:5432/projecto_formativo
# Docker:            postgres://proyecto_user:proyecto_pass@postgres:5432/projecto_formativo
# Neon (producción): postgresql://user:pass@ep-region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Base de datos NoSQL (MongoDB) — Atlas ─────────────────────────────────
# Local:             mongodb://localhost:27017/projecto_formativo
# Atlas:             mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority&appName=ClusterRED0
MONGODB_URI=
MONGODB_NAME=projecto_formativo

# ── Cloudinary (imágenes y modelos 3D) ──────────────────────────────────────
# Obtén credenciales en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# ── Wompi (pagos) ───────────────────────────────────────────────────────────
# Obtén credenciales en: https://wompi.co
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_WEBHOOK_SECRET=
WOMPI_REDIRECT_URL=http://localhost:5173/checkout/confirmacion
WOMPI_API_URL=https://sandbox.wompi.co/v1

# ── Frontend / Vite ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/
VITE_MEDIA_URL=http://localhost:8000/media/
VITE_3D_EDITOR_URL=http://localhost:3001