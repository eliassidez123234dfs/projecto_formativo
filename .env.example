# Variables de entorno - Proyecto Formativo
# Copie este archivo a .env y configure los valores segun su entorno.

# ─────────── Django Backend ───────────
SECRET_KEY=django-insecure-projecto-formativo-dev-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ─────────── Email ───────────
# En desarrollo, los emails se imprimen en consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@sistema.com

# ─────────── Base de datos (opcional: PostgreSQL) ───────────
# Por defecto usa SQLite. Descomenta estas lineas y configura
# settings.py si quieres usar PostgreSQL.
# DB_NAME=projecto_formativo
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# ─────────── Cloudinary (imagenes de productos) ───────────
# Obligatorio si se usan imagenes en produccion.
# En desarrollo local se puede dejar vacio (usa storage local).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Wompi (pasarela de pago)
WOMPI_PUBLIC_KEY=
WOMPRI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_API_URL=https://sandbox.wompi.co
WOMPI_WEBHOOK_SECRET=

# Frontend/Vite
VITE_API_URL=http://localhost:8000/api/
VITE_MEDIA_URL=http://localhost:8000/media/
VITE_WOMPI_PUBLIC_KEY=
