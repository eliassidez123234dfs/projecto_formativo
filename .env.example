# =============================================================================
#  Red Estampación — Variables de Entorno (plantilla) de ejemplo
#  Copia este archivo a .env y completa con tus credenciales antes de ejecutar el proyecto.
# =============================================================================

# ── Backend Django ───────────────────────────────────────────────────────────
# Generar una clave secreta:  python -c "import secrets; print(secrets.token_url64(64))"
SECRET_KEY=django-insecure-projecto-formativo-dev-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Correo electrónico ───────────────────────────────────────────────────────
# Opciones de EMAIL_BACKEND:
#   - 'console' (o django.core.mail.backends.console.EmailBackend): imprime los enlaces en la terminal del backend.
#   - 'smtp'    (o django.core.mail.backends.smtp.EmailBackend): envía correos reales por SMTP.
EMAIL_BACKEND=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
DEFAULT_FROM_EMAIL=noreply@sistema.com

# Base de datos opcional para PostgreSQL
# DB_NAME=projecto_formativo
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=db
# DB_PORT=5432

# ── Base de datos SQL (PostgreSQL) — Neon ──────────────────────────────────
# Local sin Docker:  postgres://proyecto_user:proyecto_pass@localhost:5432/projecto_formativo
# Docker:            postgres://proyecto_user:proyecto_pass@postgres:5432/projecto_formativo
# Neon (producción): postgresql://user:pass@ep-region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Base de datos NoSQL (MongoDB) — Atlas ─────────────────────────────────
# Local:             mongodb://localhost:27017/projecto_formativo
# Atlas:             mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority&appName=ClusterRED0
MONGODB_URI=
MONGODB_NAME=projecto_formativo

# ── Cloudinary (imágenes y modelos 3D) ──────────────────────────────────────
# Obtén credenciales en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# ── Wompi (pagos) ───────────────────────────────────────────────────────────
# Obtén credenciales en: https://wompi.co
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_WEBHOOK_SECRET=
WOMPI_REDIRECT_URL=http://localhost:5173/checkout/confirmacion
WOMPI_API_URL=https://sandbox.wompi.co/v1

# ── Frontend / Vite ─────────────────────────────────────────────────────────
# Este archivo (raíz) es la ÚNICA fuente de variables para backend + frontend + Docker.
# El microservicio Editor 3D (Tshirt3D) usa su propio archivo: microservices/Tshirt3D/.env
VITE_API_URL=http://localhost:8000/api/
VITE_MEDIA_URL=http://localhost:8000/media/
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/<cloud_name>/image/upload