# ──────────────────────────────────────────────────
# RED - Frontend Vite/React
# Variables de entorno (deben empezar con VITE_)
# Copie este archivo como .env en la carpeta frontend/
# ──────────────────────────────────────────────────

# URL base del backend Django (con /api/ al final)
# Desarrollo local:
VITE_API_URL=http://127.0.0.1:8000/api/

# Producción (Render):
# VITE_API_URL=https://red-estampacion-api.onrender.com/api/

# URL base para archivos multimedia (imágenes)
VITE_MEDIA_URL=http://127.0.0.1:8000/media/

# URL del microservicio editor 3D (Tshirt3D)
# Desarrollo local:
VITE_EDITOR_3D_URL=http://127.0.0.1:5174
