# =============================================================================
#  Editor 3D (Tshirt3D) — Variables de Entorno
#  Copia este archivo a .env en microservices/Tshirt3D/
#  NOTA: es independiente del .env de la raíz. Este microservicio usa sus
#  propias rutas de API (orders y models3d), así que NO puede compartir
#  el .env del frontend principal.
# =============================================================================

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/<cloud_name>/image/upload
VITE_MODELS3D_API_URL=http://127.0.0.1:8000/api/models3d/models/
VITE_API_URL=http://127.0.0.1:8000/api/orders/