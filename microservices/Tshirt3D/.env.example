# =============================================================================
#  Editor 3D (Tshirt3D) — Variables de Entorno
#  Copia este archivo a .env en microservices/Tshirt3D/
#  NOTA: es independiente del .env de la raíz. Este microservicio usa sus
#  propias rutas de API (orders y models3d), así que NO puede compartir
#  el .env del frontend principal.
# =============================================================================

# ── Cloudinary (subida de diseños) ─────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=doa7qxr0d
VITE_CLOUDINARY_UPLOAD_PRESET=prueba
VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/doa7qxr0d/image/upload

# ── Backend API ─────────────────────────────────────────────────────────────
# URL base del backend Django (para editor-session y models3d)
# En desarrollo:  http://127.0.0.1:8000/api
# En producción:  https://red-estampacion-api.onrender.com/api
VITE_BACKEND_API_URL=http://127.0.0.1:8000/api

# URL de models3d (CRUD de modelos 3D)
VITE_MODELS3D_API_URL=http://127.0.0.1:8000/api/models3d/models/

# URL de orders (envío de pedidos legacy)
VITE_API_URL=http://127.0.0.1:8000/api/

# ── Frontend (para botón "Volver al catálogo") ─────────────────────────────
# URL del frontend principal donde está el catálogo
# En desarrollo:  http://127.0.0.1:5173
# En producción:  https://projecto-formativo-steel.vercel.app
VITE_FRONTEND_URL=http://127.0.0.1:5173
