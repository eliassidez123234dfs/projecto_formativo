FROM node:20-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=/api/orders/
ARG VITE_MODELS3D_API_URL=/api/models3d/models/
ARG VITE_FRONTEND_URL=/
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_MODELS3D_API_URL=$VITE_MODELS3D_API_URL
ENV VITE_FRONTEND_URL=$VITE_FRONTEND_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80